#!/usr/bin/env php
<?php

require_once __DIR__ . '/../vendor/autoload.php';

use function BrainGames\Cli\game;

function isPrime(int $num): bool
{
  if ($num < 2) {
    return false;
  }

  for ($i = 2; $i <= sqrt($num); $i++) {
    if ($num % $i === 0) {
      return false;
    }
  }

  return true;
}

function questionsCreator(): array
{
  $questions = [];

  for ($i = 0; $i < 3; $i++) {
    $num = rand(5, 99);

    while (in_array($num, $questions)) {
      $num = rand(5, 99);
    }

    $questions[$num] = isPrime($num) ? 'yes' : 'no';
  }

  return  $questions;
}


$ruleText = 'Answer "yes" if given number is prime. Otherwise answer "no".';
$questions = questionsCreator();
$check = fn($answer, $correct) => $answer === $correct;

game($ruleText, $questions, $check);
