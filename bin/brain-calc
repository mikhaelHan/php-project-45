#!/usr/bin/env php
<?php

require_once __DIR__ . '/../vendor/autoload.php';

use function BrainGames\Cli\game;

function questionsCreator()
{
  $operators = ['+', '*', '-', '/'];
  $result = 0;

  $questions = [];

  while (count($questions) < 3) {

    $num1 = rand(2, 20);
    $num2 = rand(2, 20);

    $operator = ($num1 >= $num2 && $num1 % $num2 === 0)
      ? $operators[3]
      : ($num1 >= $num2 ? $operators[2]
        : $operators[rand(0, 1)]);

    switch ($operator) {
      case '+':
        $result = $num1 + $num2;
        break;

      case '-':
        $result = $num1 - $num2;
        break;

      case '*':
        $result = $num1 * $num2;
        break;

      case '/':
        $result = $num1 / $num2;
        break;
    }

    $questions["{$num1} {$operator} {$num2}"] = $result;
  }

  return $questions;
}

$ruleText = 'What is the result of the expression?';
$questions = questionsCreator();
$check = fn($answer, $correct) => $answer == $correct;

game($ruleText, $questions, $check);
